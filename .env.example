# ========================================================
# All-in-One Downloader Mini App — Environment Variables
# ========================================================

# [REQUIRED FOR TELEGRAM MINI APP]
# Bot token generated from @BotFather on Telegram (e.g. 7123456789:AAHxyz...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The live public HTTPS domain of your deployed app on Fly.io
# Used for the WebApp button and Telegram webhook registration
WEBAPP_URL=https://all-in-one-downloader.fly.dev

# [OPTIONAL] TeraBox Cookie if downloading private/session-gated TeraBox files
TERABOX_COOKIE=

# [SERVER PORT] Fly.io uses 8080 by default
PORT=8080

